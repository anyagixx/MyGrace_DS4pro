{
  "name": "@osovv/mygrace-cli",
  "version": "0.1.0",
  "description": "MyGRACE CLI — scalable GRACE methodology with lazy-loading indexes, per-module files, and phase-based navigation for large projects.",
  "license": "MIT",
  "homepage": "https://github.com/anyagixx/MyGrace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anyagixx/MyGrace.git"
  },
  "bugs": {
    "url": "https://github.com/anyagixx/MyGrace/issues"
  },
  "keywords": [
    "mygrace",
    "grace",
    "cli",
    "lint",
    "bun",
    "python",
    "typescript",
    "semantic-markup",
    "knowledge-graph",
    "lazy-loading",
    "scalable",
    "index"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/grace.ts",
    "src/grace-lint.ts",
    "src/grace-module.ts",
    "src/grace-file.ts",
    "src/grace-mcp.ts",
    "src/grace-mcp-commands.ts",
    "src/grace-common.ts",
    "src/grace-install.ts",
    "src/grace-status.ts",
    "src/grace-init.ts",
    "skills/mygrace",
    "templates",
    "README.md",
    "LICENSE",
    "packages/mygrace-status-panel"
  ],
  "type": "module",
  "packageManager": "bun@1.3.8",
  "engines": {
    "bun": ">=1.3.8"
  },
  "scripts": {
    "grace": "bun run ./src/grace.ts",
    "grace:lint": "bun run ./src/grace.ts lint",
    "lint": "bun run ./src/grace.ts lint",
    "test": "bun test",
    "validate:marketplace": "bun run ./scripts/validate-marketplace.ts",
    "prepublishOnly": "bun test && bun run ./src/grace.ts lint --path . --allow-missing-docs && bun run ./scripts/validate-marketplace.ts"
  },
  "bin": {
    "mygrace": "./src/grace.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "citty": "^0.2.2"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
