{
  "name": "mygrace-cli",
  "version": "3.4.0",
  "description": "MyGRACE — index-first engineering harness for AI coding agents: enforced contracts, lazy-loading knowledge graph, verification traceability, MCP/skills integration.",
  "license": "MIT",
  "homepage": "https://github.com/anyagixx/MyGrace_DS4pro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anyagixx/MyGrace_DS4pro.git"
  },
  "bugs": {
    "url": "https://github.com/anyagixx/MyGrace_DS4pro/issues"
  },
  "keywords": [
    "mygrace",
    "grace",
    "cli",
    "lint",
    "bun",
    "node",
    "python",
    "typescript",
    "ai-agents",
    "context-engineering",
    "semantic-markup",
    "knowledge-graph",
    "lazy-loading",
    "scalable",
    "index",
    "code-agents",
    "spec-driven"
  ],
  "files": [
    "src",
    "templates",
    "skills/mygrace",
    "packages/mygrace-status-panel",
    "ROADMAP.md",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "packageManager": "bun@1.3.8",
  "engines": {
    "bun": ">=1.3.8"
  },
  "scripts": {
    "grace": "bun run ./src/grace.ts",
    "grace:lint": "bun run ./src/grace.ts lint",
    "lint": "bun run ./src/grace.ts lint",
    "lint:demo": "bun run ./src/grace.ts lint --path examples/demo-store --strict",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:scoped": "bun test test/",
    "pack:smoke": "bun run ./scripts/pack-smoke.ts",
    "check:generated": "bun run scripts/gen-example.ts --check && bun run scripts/gen-dsh-skill-mygrace.ts --check",
    "validate:marketplace": "bun run ./scripts/validate-marketplace.ts",
    "ci": "bun run typecheck && bun run test:all && bun run lint:demo && bun run check && bun run check:generated && bun run diagram:check && bun run capsule:validate && bun run validate:marketplace && bun run validate:docs && bun run pack:smoke",
    "release:check": "bun run ci",
    "validate:docs": "bun run ./scripts/validate-docs.ts",
    "test:demo": "cd examples/demo-store && bun test",
    "test:all": "bun test && bun run test:demo",
    "lint:self": "bun run ./src/grace.ts lint --path . --strict",
    "check": "bun run ./src/grace.ts ci --path .",
    "publish:dry": "bun run ./scripts/publish-dry-run.ts",
    "release:full": "bun run release:check && bun run publish:dry",
    "test:integrations": "bun run ./scripts/integration-octocode-smoke.ts",
    "diagram": "bun run ./src/grace.ts diagram",
    "diagram:check": "bun run ./src/grace.ts diagram --check",
    "test:integrations:archify": "bun run ./scripts/integration-archify-smoke.ts",
    "capsule:validate": "bun run ./src/grace.ts capsule validate"
  },
  "bin": {
    "mygrace": "src/grace.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "citty": "^0.2.2",
    "fast-xml-parser": "^5.12.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.2"
  }
}
